{
  // Explicit build configuration for Cloudflare Workers.
  //
  // Without this file wrangler tries to AUTO-configure the project, and from
  // 4.156.0 it refuses to do that here: it sees a `functions/` directory beside
  // static files in the repo root, reads that as a Pages project using Pages
  // Functions, and stops rather than risk deploying the site while leaving the
  // Functions behind. Its own error message offers this file as the way out.
  //
  // Nothing about the repo changed to cause that. The build command is
  // `npx wrangler deploy`, which is unpinned, so every build installs whatever
  // wrangler is newest; builds up to 29 Oct 2026 got a version without the
  // check and passed, and the next build got 4.156.0 and failed. Declaring the
  // configuration explicitly means a future wrangler release has nothing left
  // to guess about.
  //
  // Generated by Cloudflare's own `cloudflare/workers-autoconfig` branch. That
  // branch also deletes the blog and the YouTube sync workflow, so only this
  // file is taken from it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dhanx-website",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
